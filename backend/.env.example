# Example Environment Configuration for FastAPI Backend
# Rename to .env for local production configuration

PROJECT_NAME="AI Real-Time Camera Vision API"
VERSION="0.3.0"
LOG_LEVEL="INFO"

# Security & Network Settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
MAX_CONCURRENT_INFERENCE=1
MAX_PAYLOAD_MB=10.0
SESSION_TTL_SECONDS=600

# AI Model Configuration
MODEL_PATH="yolov8n.pt"
CONFIDENCE_THRESHOLD=0.25
INFERENCE_SIZE=640
TARGET_DEVICE="auto"
DEVICE="auto"
AI_TARGET_FPS=10

# SAM Segmentation Settings
SEGMENTATION_ENABLED=true
SEGMENTATION_MODEL="FastSAM-s.pt"
SEGMENTATION_TARGET_FPS=3
SEGMENTATION_DEVICE="auto"

# Monocular Depth Estimation Settings
DEPTH_ENABLED=true
DEPTH_MODEL="MiDaS_small"
DEPTH_TARGET_FPS=3
DEPTH_INPUT_SIZE=256
DEPTH_DEVICE="auto"
DEPTH_SMOOTHING_ALPHA=0.35

# Approximate Distance Calibration Settings
DISTANCE_ESTIMATION_ENABLED=true
CALIBRATION_METHOD="inverse_reference"
REFERENCE_DISTANCE_METERS=2.0
REFERENCE_DEPTH_VALUE=0.55
CALIBRATION_PARAM_A=0.9864
CALIBRATION_PARAM_B=-0.0370
DISTANCE_MIN_METERS=0.3
DISTANCE_MAX_METERS=15.0
DISTANCE_SMOOTHING_ALPHA=0.35
