# Full-Stack Deployment Environment Configuration Template
# Copy to .env or configure in Cloud Provider Environment Variables (Render, Railway, AWS)

# Backend Environment Settings
PORT=8000
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.25
INFERENCE_SIZE=640
MAX_CONCURRENT_INFERENCE=1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Build Environment Variable
# Set to your deployed production backend domain (e.g. https://api.vision-x.com)
VITE_API_URL=http://localhost:8000
